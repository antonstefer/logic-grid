{
  "name": "logic-grid",
  "compatibility_date": "2026-03-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // The top-level "enabled" is what turns Workers Logs on. With only
  // logs.enabled set, wrangler leaves it out and the Worker keeps no logs.
  "observability": {
    "enabled": true
  }
}

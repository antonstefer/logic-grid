{
  "name": "logic-grid-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "logic-grid": "*",
    "logic-grid-ai": "*"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
